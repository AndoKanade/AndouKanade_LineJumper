---
title: プレイヤーの移動の状態（State パターン）
---
classDiagram
    direction TB

    class Player {
        -unique_ptr~State~ state_
        +UpdateMovement() bool
        -ChangeState(unique_ptr~State~) void
    }

    class State["Player::State"] {
        <<abstract>>
        +UpdateMovement() unique_ptr~State~*
        +IsOnRail() bool*
    }

    class RailRunState {
        +UpdateMovement() unique_ptr~State~
    }

    class RailHopState {
        +UpdateMovement() unique_ptr~State~
    }

    class RailSwitchState {
        +UpdateMovement() unique_ptr~State~
    }

    class OffRailState {
        <<abstract>>
        +IsOnRail() bool
    }

    class PlatformState {
        +UpdateMovement() unique_ptr~State~
    }

    class FallState {
        +UpdateMovement() unique_ptr~State~
    }

    Player *-- State : 今の状態を1つ所有
    State <|-- RailRunState
    State <|-- RailHopState
    State <|-- RailSwitchState
    State <|-- OffRailState
    OffRailState <|-- PlatformState
    OffRailState <|-- FallState
